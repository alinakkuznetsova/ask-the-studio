# copy to .env and fill in. never commit .env
OPENAI_API_KEY=

# models (override if your openai account offers newer ones)
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
JUDGE_MODEL=gpt-4.1-mini

# server
PORT=3000
# set to 1 when running behind a single trusted proxy (railway, render, fly)
TRUST_PROXY=0

# abuse and cost controls
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_CAP=1000

# optional: langfuse tracing and eval scores (off unless both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
